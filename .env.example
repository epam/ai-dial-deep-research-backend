# Docker. Uncomment on Apple Silicon (M1/M2/M3/M4) — DIAL images ship linux/amd64 only.
#DOCKER_DEFAULT_PLATFORM=linux/amd64

APP_HOST=0.0.0.0
# macOS: AirPlay Receiver occupies port 5000 — pick another port (e.g. 5001) and re-run
# `make infra-config` so DIAL core routes there too.
APP_PORT=5000

# DIAL Core the app talks to. Required — no built-in default. Local stack: the host-run app
# reaches DIAL core at localhost:8081.
DIAL_URL=http://localhost:8081

# Remote DIAL the local model config is pulled from. Used only by `make infra-config`;
# the app itself never reads these.
REMOTE_DIAL_URL=
REMOTE_DIAL_API_KEY=

LOG_LEVEL=INFO
# Level of the app's own logger, independent of LOG_LEVEL (see README for LOG_FORMAT and
# LOG_DATE_FORMAT).
DEEP_RESEARCH_LOG_LEVEL=INFO
# Payload debugging (local development only — never enable in a shared environment).
# When true, assembled LLM requests are logged at DEBUG (truncated per string) and the
# openai/httpx/httpcore INFO cap is lifted. See README for details.
#LOG_PAYLOADS=false
#LOG_PAYLOADS_MAX_LENGTH=2000
