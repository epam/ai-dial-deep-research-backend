# Docker. Uncomment on Apple Silicon (M1/M2/M3/M4) — DIAL images ship linux/amd64 only.
#DOCKER_DEFAULT_PLATFORM=linux/amd64

APP_HOST=0.0.0.0
# macOS: AirPlay Receiver occupies port 5000 — pick another port (e.g. 5001) and re-run
# `make infra-config` so DIAL core routes there too.
APP_PORT=5000

MCP_SERVER_NAME=mcp-server-name

# MCP connection — configure exactly ONE mode (uncomment and fill one block below);
# the app fails fast at startup if neither is set. Downstream DIAL Core auth (LLM, files,
# and the deployment-mode MCP) uses the per-request api-key, so there is no DIAL_API_KEY.
#
# Deployment mode: the generic-RAG MCP server is a DIAL application reached through Core.
#MCP_DEPLOYMENT_NAME=generic-rag-mcp
#
# Local-dev mode: a directly-reachable MCP server with its static key.
#MCP_URL=http://host.docker.internal:8000/mcp
#MCP_API_KEY=

# Remote DIAL the local model config is pulled from. Used only by `make infra-config`;
# the app itself never reads these.
REMOTE_DIAL_URL=
REMOTE_DIAL_API_KEY=

LOG_LEVEL=INFO
